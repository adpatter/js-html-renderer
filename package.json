{
  "name": "js-html-renderer",
  "version": "1.0.1",
  "description": "A JavaScript DSL for rendering HTML on the client or server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "test"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "build": "tsc --build .",
    "clean:build": "npm run clean && npm run build",
    "watch": "tsc --watch",
    "format": "prettier --write .",
    "format:lint": "npm run format && npm run lint",
    "lint": "eslint src",
    "lint:all": "eslint .",
    "check": "npm run lint:all && npm test",
    "prepack": "npm run clean:build",
    "test": "npm run clean:build && npm run test --workspace ./test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjpatterson/js-html-renderer.git"
  },
  "author": "FAR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adamjpatterson/js-html-renderer/issues"
  },
  "homepage": "https://github.com/adamjpatterson/js-html-renderer#readme",
  "engines": {
    "npm": ">=10.2.3",
    "node": ">=18.19.0"
  },
  "devDependencies": {
    "@types/web": "^0.0.139",
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/node": "^20.11.28",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "keywords": [
    "engine",
    "html",
    "renderer",
    "template"
  ],
  "type": "commonjs"
}
